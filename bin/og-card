#!/usr/bin/env bash
# Render a 1200x630 link-preview card for a blog post (Slack, LinkedIn, X...).
#
#   bin/og-card _posts/2026-03-20-my-post.md
#
# Writes assets/og/posts/<slug>.png using the post's title and tags, in the
# site's terminal style. Add `image: /assets/og/posts/<slug>.png` to the post.
# Needs Google Chrome (macOS).
set -euo pipefail

post="${1:?Usage: bin/og-card _posts/YYYY-MM-DD-slug.md}"
root="$(cd "$(dirname "$0")/.." && pwd)"
chrome="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
[ -x "$chrome" ] || { echo "Google Chrome not found" >&2; exit 1; }

slug="$(basename "$post" .md | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')"
title="$(awk -F': ' '/^title:/ {sub(/^title: */, ""); gsub(/^"|"$/, ""); print; exit}' "$post")"
tags="$(awk '/^tags:/ {gsub(/^tags: *\[|\]|,/, ""); print; exit}' "$post")"
date="$(basename "$post" | cut -c1-10)"
esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
tagline=""; for t in $tags; do tagline="$tagline<span>#$t</span>"; done
cat > "$tmp/card.html" <<EOF
<!doctype html><html><head><meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@700&family=JetBrains+Mono:wght@400;600&display=block" rel="stylesheet">
<style>
html,body{margin:0;width:1200px;height:630px;background:#0c0c0e;color:#e4e4e7;font-family:Inter,sans-serif;overflow:hidden}
.c{box-sizing:border-box;height:100%;padding:72px 96px;display:flex;flex-direction:column;justify-content:space-between;
background:radial-gradient(900px 500px at 100% 0%,rgba(74,222,128,.10),transparent 60%)}
.top{display:flex;justify-content:space-between;font:400 26px 'JetBrains Mono',monospace;color:#8b8b94}
.logo{font-weight:600;color:#e4e4e7}.logo b{color:#4ade80;font-weight:600}
h1{font-weight:700;font-size:64px;letter-spacing:-2px;line-height:1.08;margin:0;max-width:1000px}
.f{font:400 24px 'JetBrains Mono',monospace;color:#5c5c66;display:flex;justify-content:space-between}
.f span+span{margin-left:18px}.tags span{color:#4ade80}
</style></head><body><div class="c">
<div class="top"><span class="logo"><b>~/</b>raincrash</span><span>$date</span></div>
<h1>$(esc "$title")</h1>
<div class="f"><span>sric.me · Sricharan Chiruvolu</span><span class="tags">$tagline</span></div>
</div></body></html>
EOF

mkdir -p "$root/assets/og/posts"
out="$root/assets/og/posts/$slug.png"
"$chrome" --headless=new --disable-gpu --hide-scrollbars --virtual-time-budget=4000 \
  --window-size=1200,630 --screenshot="$out" "file://$tmp/card.html" >/dev/null 2>&1
echo "Wrote ${out#$root/}"
