#!/usr/bin/env bash
# Preview the site at http://localhost:4000 with live reload (drafts included).
#
#   bin/serve            # first run installs gems into vendor/bundle
#   PORT=4001 bin/serve
#
# Needs Ruby 3.3 (brew install ruby@3.3). The github-pages gem pins the same
# Jekyll + plugin versions GitHub Pages uses, so local == live.
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/_env

exec bundle exec jekyll serve --livereload --drafts --port "${PORT:-4000}" "$@"
