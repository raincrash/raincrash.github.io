# Shared setup for bin/serve and bin/build (sourced, not run directly).
# Finds Ruby 3.3 and installs gems into vendor/bundle on first use.

if [ -d /opt/homebrew/opt/ruby@3.3/bin ]; then
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
elif [ -d /usr/local/opt/ruby@3.3/bin ]; then
  export PATH="/usr/local/opt/ruby@3.3/bin:$PATH"
fi

if ! ruby -e 'exit(RUBY_VERSION.start_with?("3.3") ? 0 : 1)' 2>/dev/null; then
  echo "Ruby 3.3 not found (have: $(ruby -v 2>/dev/null || echo none))." >&2
  echo "Install it with:  brew install ruby@3.3" >&2
  exit 1
fi

# Sass needs a UTF-8 locale.
export LANG="${LANG:-en_US.UTF-8}" LC_ALL="${LC_ALL:-en_US.UTF-8}"

if [ ! -d vendor/bundle ]; then
  bundle config set --local path vendor/bundle
  bundle install
fi
