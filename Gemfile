source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages builds with.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
  gem "jekyll-seo-tag"
end

# Gems no longer bundled by default in Ruby 3.4+/4.x
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
gem "observer"
